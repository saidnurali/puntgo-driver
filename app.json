{
  "expo": {
    "name": "PuntEats Driver",
    "slug": "punteats-driver",
    "version": "1.0.0",
    "scheme": "punteatsdriver",
    "orientation": "portrait",
    "icon": "./assets/images/app_logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/app_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#10B981"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.puntgo.punteatsdriver",
      "icon": "./assets/images/app_logo.png",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "PuntEats Driver requires background location to track live deliveries and share real-time progress with customers.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "PuntEats Driver requires background location to track live deliveries and share real-time progress with customers.",
        "UIBackgroundModes": [
          "location",
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.puntgo.punteatsdriver",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app_logo.png",
        "backgroundColor": "#10B981"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK",
        "SYSTEM_ALERT_WINDOW",
        "USE_FULL_SCREEN_INTENT"
      ]
    },
    "web": {
      "favicon": "assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-location",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/app_logo.png",
          "color": "#10B981",
          "sounds": [
            "assets/sounds/order_alert.wav",
            "assets/sounds/order_alarm.mp3"
          ]
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5d04b108-4a08-42eb-a221-fa3b32cdcdb1"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "shiikhdoon"
  }
}